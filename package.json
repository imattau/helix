{
  "name": "helix",
  "version": "0.2.0",
  "description": "Decentralized DNA-math-driven social protocol prototype on libp2p",
  "type": "module",
  "private": true,
  "scripts": {
    "peer:a": "tsx src/cli/peer.ts --name alice --port 9001",
    "peer:b": "tsx src/cli/peer.ts --name bob --port 9002",
    "relay": "tsx src/cli/relay.ts",
    "build:relay": "esbuild src/cli/relay.ts --bundle --platform=node --format=cjs --outfile=dist/helix-relay.cjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@0xx0lostcause0xx0/polypack": "^2.5.0",
    "@chainsafe/libp2p-gossipsub": "^14.1.2",
    "@chainsafe/libp2p-noise": "^16.1.5",
    "@chainsafe/libp2p-yamux": "^7.0.4",
    "@helia/bitswap": "^4.0.8",
    "@helia/http": "^4.0.6",
    "@helia/libp2p": "^1.0.8",
    "@helia/unixfs": "^8.0.5",
    "@ipld/dag-cbor": "^10.0.2",
    "@ipld/dag-json": "^11.0.1",
    "@libp2p/autonat": "2.0.38",
    "@libp2p/bootstrap": "^11.0.0",
    "@libp2p/circuit-relay-v2": "3.2.24",
    "@libp2p/crypto": "5.1.8",
    "@libp2p/dcutr": "2.0.38",
    "@libp2p/identify": "^3.0.39",
    "@libp2p/kad-dht": "^15.1.11",
    "@libp2p/logger": "^5.2.0",
    "@libp2p/mdns": "^11.0.47",
    "@libp2p/peer-id": "^5.1.9",
    "@libp2p/ping": "^2.0.37",
    "@libp2p/tcp": "^10.1.19",
    "@libp2p/utils": "^6.7.2",
    "@libp2p/websockets": "^9.2.12",
    "@multiformats/multiaddr": "^12.5.1",
    "@multiformats/multiaddr-matcher": "^2.0.2",
    "@multiformats/multiaddr-v13": "npm:@multiformats/multiaddr@^13.0.3",
    "@noble/hashes": "^1.8.0",
    "abort-error": "^1.0.2",
    "blockstore-core": "^7.0.1",
    "datastore-core": "^12.0.1",
    "helia": "^7.1.3",
    "interface-blockstore": "^7.0.1",
    "interface-datastore": "^8.3.2",
    "interface-store": "^6.0.3",
    "it-pushable": "^3.2.4",
    "libp2p": "^2.10.0",
    "main-event": "^1.0.4",
    "multiformats": "^14.0.5",
    "multiformats-v13": "npm:multiformats@^13.4.2",
    "qrcode": "^1.5.4",
    "uint8arraylist": "^2.4.9",
    "uint8arrays": "^5.1.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.5",
    "@types/qrcode": "^1.5.6",
    "esbuild": "^0.28.1",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  }
