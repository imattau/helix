# Helix Relay configuration - see src/cli/relay.ts.
#
# Requires Node.js 22+ (install.sh/the .deb both enforce this) - Ubuntu's own apt
# nodejs package (18.x on 24.04) is too old, confirmed by actually running this on
# it: it starts, then crash-loops on first use (missing global CustomEvent, then
# missing Promise.withResolvers). Install from NodeSource instead:
#   curl -fsSL https://deb.nodesource.com/setup_22.x | sudo -E bash -
#   apt-get install -y nodejs
#
# After editing, apply changes with: systemctl restart helix-relay

# TCP port to listen on (the WebSocket listener uses this port + 1).
HELIX_RELAY_PORT=4001

# Directory for the relay's persisted identity key and other state. Its PeerId
# (derived from this key) is embedded in every /p2p-circuit address this relay has
# ever handed out - back this directory up, and never share it between relays.
HELIX_RELAY_DATA_DIR=/var/lib/helix-relay

# Public hostname of a reverse proxy in front of this relay (nginx/Caddy/etc.
# terminating TLS on 443 and forwarding to this node's WebSocket listener). Leave
# blank if this host has a direct public IP with HELIX_RELAY_PORT itself reachable -
# without one or the other, nothing on the internet can actually dial this relay.
# Example: relay.example.com
HELIX_RELAY_PROXY=

# Port for the relay's own small web page - a QR code and copyable text for this
# relay's bootstrap multiaddr, styled after the Helix app, meant to be linked from a
# README/Discord/etc so people can point Settings -> Bootstrap Server at it without
# hand-typing a multiaddr. Defaults to HELIX_RELAY_PORT + 2 if unset; set to 0 to
# disable it entirely. Proxy this behind the same (or a separate) reverse-proxy host
# if you want it reachable over HTTPS on 443 rather than this raw port.
HELIX_RELAY_WEB_PORT=
