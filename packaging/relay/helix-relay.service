[Unit]
Description=Helix circuit-relay anchor + peer directory
Documentation=https://github.com/helix-project/helix
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=helix-relay
Group=helix-relay
EnvironmentFile=/etc/helix-relay/helix-relay.env
ExecStart=/usr/bin/node /opt/helix-relay/helix-relay.cjs
WorkingDirectory=/var/lib/helix-relay
Restart=on-failure
RestartSec=5

# Hardening - this process only ever needs network access and its own data dir.
# No MemoryDenyWriteExecute: Node's V8 JIT needs RWX pages for compiled JS - with it
# on, systemd's seccomp filter kills the process instantly (SIGSYS/SIGTRAP on start).
# Confirmed by actually running this unit, not just reading it - it looked correct on
# paper and failed on the very first start.
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
ReadWritePaths=/var/lib/helix-relay
CapabilityBoundingSet=
AmbientCapabilities=
RestrictSUIDSGID=yes
LockPersonality=yes

[Install]
WantedBy=multi-user.target
